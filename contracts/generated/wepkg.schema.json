          "sha256": "d9067c6c77679d0d0523f400fd659630b797d0aa2e6e22e6761a3983b811a451",
          "references": []
        }
      ],
      "files": [
        {
          "path": "definitions/coffee.json",
          "sha256": "d9067c6c77679d0d0523f400fd659630b797d0aa2e6e22e6761a3983b811a451",
          "size_bytes": 83,
          "media_type": "application/json",
          "rights": {
            "license": "CC0-1.0",
