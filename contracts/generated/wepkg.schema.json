            ]
          }
        }
      ],
      "dependencies": [],
      "requirements": {
        "model_capabilities": [],
        "tool_capabilities": [],
        "presentation_capabilities": [
          {
            "capability_id": "text",
            "required": true
          }
        ],
        "tested_configurations": []
      },
      "provenance": {
        "author_display_name": "Loreviva synthetic example",
        "created_at": "2026-10-10T02:00:00Z",
        "license": "CC0-1.0",
        "source_references": [
          "Synthetic example; no real player or credential"
        ],
        "synthetic_examples_only": true
      }
    }
  ],
