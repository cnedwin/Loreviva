LOREVIVA_MODE=all
LOREVIVA_HTTP_ADDR=127.0.0.1:8080
LOREVIVA_DB_ADDR=127.0.0.1:3306
LOREVIVA_DB_NAME=loreviva_dev
LOREVIVA_DB_USER=loreviva_dev
LOREVIVA_DB_PASSWORD_REF=env:LOREVIVA_DB_PASSWORD
# Set LOREVIVA_DB_PASSWORD securely in your environment; no default password.
LOREVIVA_FILES_ROOT=./var/private-files
LOREVIVA_MODEL_MODE=mock
LOREVIVA_BILLING_MODE=mock
LOREVIVA_PUBLIC_BASE_URL=http://127.0.0.1:8080
LOREVIVA_OPERATOR_TENANT=demo-local
LOREVIVA_OPERATOR_PRODUCT=coffee
LOREVIVA_OPERATOR_SUBJECT=creator
LOREVIVA_OPERATOR_CREDENTIAL_ID=owner
LOREVIVA_OPERATOR_SECRET_REF=env:LOREVIVA_OPERATOR_TOKEN
# Resolve LOREVIVA_OPERATOR_TOKEN privately to32..512 bytes; retain it across restart.
