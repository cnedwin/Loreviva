root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = false

[*.{png,jpg,jpeg,gif,webp,ico,woff,woff2,ttf,otf,pdf,zip,wasm,exe,dll}]
charset = unset
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false

[LICENSES/**]
charset = unset
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false
